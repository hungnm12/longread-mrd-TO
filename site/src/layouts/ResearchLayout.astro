---
// Layout for the long-form research narrative.
//
// A conventional academic page: header with title and section navigation, one scrollable
// column of content, a sticky table of contents beside it, and a footer carrying project
// status and citation information. Nothing here paginates, snaps, or captures the arrow
// keys — the page is scrolled by the reader, at whatever pace they read.
import "@styles/global.css";
import TableOfContents from "@components/TableOfContents.astro";
import { narrativeSections, siteMeta } from "@data/siteMeta";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <a class="skip-link" href="#overview">Skip to content</a>
    <header class="research-header">
      <div class="shell research-header__row">
        <div class="research-header__brand">
          <a class="research-header__title" href="/research-narrative/">{siteMeta.shortTitle}</a>
          <p class="research-header__status">{siteMeta.status}</p>
        </div>
        <nav class="research-header__nav" aria-label="Sections">
          {narrativeSections.map((section) => (
            <a href={`#${section.id}`}>{section.short}</a>
          ))}
          <a class="research-header__nav-aside" href="/">← Research OS</a>
          <a class="research-header__nav-aside" href={siteMeta.researchNotesHref}>Research notes</a>
          <a class="research-header__nav-aside" href={siteMeta.repositoryUrl} rel="noreferrer">
            Repository
          </a>
        </nav>
      </div>
    </header>

    <div class="shell research-shell">
      <aside class="research-toc">
        <TableOfContents items={narrativeSections} />
      </aside>
      <main class="research-main">
        <slot />
      </main>
    </div>

    <footer class="research-footer">
      <div class="shell research-footer__row">
        <div>
          <p class="research-footer__label">Project status</p>
          <p>{siteMeta.status}</p>
        </div>
        <div>
          <p class="research-footer__label">Last updated</p>
          <p>{siteMeta.lastUpdated}</p>
        </div>
        <div>
          <p class="research-footer__label">Citation and repository</p>
          <p>
            Cite as: <em>{siteMeta.title}</em>, research website, {siteMeta.lastUpdated}.
            <br />
            <a href={siteMeta.repositoryUrl} rel="noreferrer">{siteMeta.repositoryUrl}</a>
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
