---
import BaseLayout from "@layouts/BaseLayout.astro";
import Badge from "@components/Badge.astro";
import Callout from "@components/Callout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("results");
  return entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description="Result">
  <section class="hero">
    <span class="eyebrow">{entry.data.id}</span>
    <h1>{entry.data.title}</h1>
    <div class="pill-list">
      <Badge label={entry.data.evidence_level} tone="preliminary" />
      <Badge label={entry.data.status} />
    </div>
  </section>
  <section class="stack">
    <Callout title="Observation" tone="observation">
      <p>{entry.data.observation}</p>
    </Callout>
    <Callout title="Interpretation" tone="interpretation">
      <p>{entry.data.interpretation}</p>
    </Callout>
    <Callout title="Caveat" tone="caveat">
      <ul class="list-clean">
        {entry.data.caveats.map((item) => <li>{item}</li>)}
      </ul>
    </Callout>
    <section class="content-panel"><Content /></section>
  </section>
</BaseLayout>
