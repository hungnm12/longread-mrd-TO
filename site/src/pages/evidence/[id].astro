---
// One evidence record: what it is, what produced it, what it is claimed to support, and how
// far it has actually been checked.
//
// `linked_claims` is the field that matters at a meeting — it is the list of statements that
// fall if this artifact turns out to be wrong.
import ResearchOsLayout from "@layouts/ResearchOsLayout.astro";
import { getCollection } from "astro:content";
import { loadResearchOs, logHref, suggestionHref } from "@utils/researchOs";

export async function getStaticPaths() {
  const evidence = await getCollection("evidenceRecords");
  return evidence.map((entry) => ({
    params: { id: entry.data.id.toLowerCase() },
    props: { evidenceId: entry.data.id }
  }));
}

const { evidenceId } = Astro.props;
const { evidenceById, reports } = await loadResearchOs();
const entry = evidenceById.get(evidenceId)!;
const data = entry.data;

const citedInReports = reports.filter(
  (report) =>
    report.data.work_completed.some((item) => item.evidence.includes(evidenceId)) ||
    report.data.results.some((result) => result.evidence.includes(evidenceId))
);
const isExternal = /^https?:\/\//.test(data.path_or_url);
---

<ResearchOsLayout area="evidence" title={`${data.id} — ${data.title}`} description={data.description}>
  <header class="os-page-head">
    <p class="os-breadcrumb"><a href="/evidence/">Evidence registry</a> / {data.id}</p>
    <h1>{data.title}</h1>
    <p class="os-badges">
      <span class="os-card__kind">{data.type.replace(/_/g, " ")}</span>
      <span class={`verify verify--${data.verification_status}`}>
        {data.verification_status.replace(/_/g, " ")}
      </span>
      <span class="os-card__kind">Created {data.created_at}</span>
    </p>
  </header>

  <div class="os-grid">
    <section class="os-panel os-panel--wide">
      <h2>Description</h2>
      <p>{data.description}</p>
      <h2 class="os-panel__subhead">Claims that depend on it</h2>
      {data.linked_claims.length === 0 ? (
        <p class="os-empty">No claim currently depends on this artifact.</p>
      ) : (
        <ul class="os-list os-list--plain">
          {data.linked_claims.map((claim) => <li>{claim}</li>)}
        </ul>
      )}
      {data.notes && <p class="os-note">{data.notes}</p>}
    </section>

    <section class="os-panel">
      <h2>Provenance</h2>
      <dl class="os-card__fields">
        <dt>Path</dt>
        <dd>
          {isExternal ? (
            <a href={data.path_or_url} rel="noreferrer">{data.path_or_url}</a>
          ) : (
            <code class="os-path">{data.path_or_url}</code>
          )}
        </dd>
        <dt>Generated by</dt>
        <dd><code>{data.generated_by}</code></dd>
        <dt>Input data</dt>
        <dd>
          {data.input_data.length === 0 ? "—" : (
            <ul class="os-list os-list--plain">{data.input_data.map((input) => <li>{input}</li>)}</ul>
          )}
        </dd>
        <dt>Verified by</dt>
        <dd>{data.verified_by ? `${data.verified_by} on ${data.verified_on}` : "not verified"}</dd>
      </dl>
    </section>
  </div>

  <section class="os-section">
    <h2>Where it is used</h2>
    <ul class="os-list">
      {data.linked_log && <li>Daily log: <a href={logHref(data.linked_log)}>{data.linked_log}</a></li>}
      {data.linked_suggestion && (
        <li>Suggestion: <a href={suggestionHref(data.linked_suggestion)}>{data.linked_suggestion}</a></li>
      )}
      {citedInReports.map((report) => (
        <li>Weekly report: <a href={`/weekly-reports/${report.data.id.toLowerCase()}/`}>{report.data.id}</a></li>
      ))}
      {!data.linked_log && !data.linked_suggestion && citedInReports.length === 0 && (
        <li class="os-empty">Not referenced by any log, suggestion or report.</li>
      )}
    </ul>
  </section>
</ResearchOsLayout>
