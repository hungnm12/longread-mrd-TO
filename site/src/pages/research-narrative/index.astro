---
// Level 0 — for someone who knows biology and nothing about this project.
//
// Deliberately short: the goal, why it is hard, the six problems, and what we are testing right
// now. No axes, no matrices, no literature, no gap detail. Everything deeper is one click away.
import { getCollection } from "astro:content";
import NarrativeLayout from "@layouts/NarrativeLayout.astro";
import { researchOs } from "@utils/researchOs";

const components = (await getCollection("detectorComponents")).sort((a, b) => a.data.order - b.data.order);
const gaps = await getCollection("designGaps");

const os = researchOs as {
  active_gap: string;
  research_goal: string;
  current_stage_plain: string;
};
const activeGap = gaps.find((gap) => gap.id === os.active_gap)!;

// One plain-language line per component, and one glyph. The glyph is a mnemonic, not decoration:
// it marks the same component consistently across the map and the component pages.
const plain: Record<string, { line: string; glyph: string }> = {
  "marker-discovery": { line: "What should we track?", glyph: "◎" },
  "molecule-recognition": { line: "Does this observation look tumor-derived?", glyph: "⧉" },
  "background-suppression": { line: "Could this signal come from error or normal biology?", glyph: "⊘" },
  aggregation: { line: "How do weak observations combine?", glyph: "∑" },
  "decision-rule": { line: "When do we call MRD positive?", glyph: "⟐" },
  validation: { line: "How do we prove the detector works?", glyph: "✓" }
};

const stateGlyph: Record<string, string> = {
  SUPPORTED: "✓",
  "NOT-SUPPORTED": "✗",
  UNRESOLVED: "?",
  UNEXPLORED: "?",
  INCONCLUSIVE: "?",
  BLOCKED: "■",
  PARKED: "■"
};

function componentStatus(componentId: string) {
  const primary = gaps.filter((gap) => gap.data.component === componentId);
  const active = primary.find((gap) => gap.id === os.active_gap);
  if (active) return { label: "active research", tone: "active", detail: active.id };
  if (primary.length > 0) {
    return { label: `${primary.length} open question${primary.length > 1 ? "s" : ""}`, tone: "open", detail: primary.map((g) => g.id).join(" · ") };
  }
  return { label: "not started", tone: "idle", detail: "" };
}
---

<NarrativeLayout
  section="home"
  title="MRD Research OS"
  description="Can long-read ONT provide evidence that helps distinguish tumor-derived signal from background?"
>
  <section class="nv-hero">
    <p class="nv-hero__kicker">MRD Research OS</p>
    <h1>{os.research_goal}</h1>
    <p class="nv-hero__stage">
      <span>Current stage</span>
      {os.current_stage_plain}
    </p>
    <a class="nv-cta" href="/research-narrative/map/">Explore the MRD detector map →</a>
  </section>

  <section class="nv-why">
    <p>
      MRD detection is difficult because tumor-derived molecules are extremely rare — and the
      molecules around them are chemically identical. A complete detector therefore has to solve
      several different problems, not one.
    </p>
  </section>

  <section class="nv-components">
    <h2>What a detector needs to solve</h2>
    <div class="nv-grid">
      {components.map((component) => {
        const info = plain[component.id] ?? { line: component.data.question, glyph: "•" };
        const status = componentStatus(component.id);
        return (
          <a class={`nv-card nv-card--${status.tone}`} href={`/research-narrative/component/${component.id}/`}>
            <span class="nv-card__glyph" aria-hidden="true">{info.glyph}</span>
            <span class="nv-card__index">{String(component.data.order).padStart(2, "0")}</span>
            <span class="nv-card__name">{component.data.short}</span>
            <span class="nv-card__line">{info.line}</span>
            <span class="nv-card__status">
              {status.label}{status.detail && <em>{status.detail}</em>}
            </span>
          </a>
        );
      })}
    </div>
  </section>

  <section class="nv-current">
    <p class="nv-current__kicker">Current research</p>
    <h2>{activeGap.id} — {activeGap.data.title}</h2>

    <p class="nv-current__asking">
      <span>We are currently asking</span>
      Does observing multiple ALT alleles on the same long ONT molecule provide tumor-specific
      evidence?
    </p>

    <div class="nv-learned">
      <p class="nv-learned__label">What we learned so far</p>
      <ul>
        {activeGap.data.state.map((entry) => (
          <li class={`nv-learned__row nv-learned__row--${entry.value.toLowerCase().replace(/[^a-z]/g, "")}`}>
            <span class="nv-learned__glyph" aria-hidden="true">{stateGlyph[entry.value] ?? "?"}</span>
            <span class="nv-learned__dim">{entry.dimension}</span>
            <span class="nv-learned__val">{entry.value.replace(/-/g, " ").toLowerCase()}</span>
          </li>
        ))}
      </ul>
    </div>

    <p class="nv-current__next">
      <span>Next question</span>
      {activeGap.data.active_question}
    </p>

    <a class="nv-cta nv-cta--strong" href={`/research-narrative/gap/${activeGap.id.toLowerCase()}/`}>
      Open the {activeGap.id} research journey →
    </a>
  </section>

  <section class="nv-deeper">
    <h2>If you want more detail</h2>
    <div class="nv-deeper__grid">
      <a href="/research-narrative/map/"><strong>Detector map</strong><span>the six problems, and where the work sits</span></a>
      <a href="/research-narrative/literature/"><strong>Literature</strong><span>what the field has tried, by component</span></a>
      <a href="/research-narrative/resources/"><strong>Resources</strong><span>what this data and platform actually provide</span></a>
      <a href="/research-narrative/design-space/"><strong>Design space</strong><span>advanced: the eleven axes behind the six problems</span></a>
      <a href="/research-narrative/reports/"><strong>Reports</strong><span>what changed, day by day and week by week</span></a>
    </div>
  </section>
</NarrativeLayout>
