---
import BaseLayout from "@layouts/BaseLayout.astro";
import Badge from "@components/Badge.astro";
import { candidateLandscape } from "@data/week001";
import { researchRoadmap } from "@data/roadmap";
import { loadCollections, entryHref } from "@utils/content";

const { weeks, questions, hypotheses, results, decisions } = await loadCollections();
const week = weeks[0];
const question = questions[0];
const hypothesis = hypotheses[0];
const result = results[0];
const decision = decisions[0];
---

<BaseLayout
  title="Dashboard"
  description="Current tumor-only MRD research question, evidence goal, blockers, and next decision."
>
  <section class="hero">
    <span class="eyebrow">Phase 1 research OS</span>
    <h1>Week 1 stays focused on the tumor-only candidate landscape.</h1>
    <p class="muted">
      The current site state answers the five weekly questions from the brief: what is being
      studied, why it matters, what evidence exists, what remains uncertain, and what the next
      smallest decision should be.
    </p>
    <div class="pill-list">
      <Badge label="Tumor-only first" />
      <Badge label="Preliminary evidence" tone="preliminary" />
      <Badge label="Static-first build" />
    </div>
  </section>

  <section class="grid grid--cards">
    <article class="card metric">
      <span class="muted">Current research question</span>
      <div class="metric__value">{question.data.id}</div>
      <a href={entryHref("questions", question.slug)}>{question.data.title}</a>
    </article>
    <article class="card metric">
      <span class="muted">Current hypothesis</span>
      <div class="metric__value">{hypothesis.data.id}</div>
      <a href={entryHref("hypotheses", hypothesis.slug)}>{hypothesis.data.title}</a>
    </article>
    <article class="card metric">
      <span class="muted">This week&apos;s evidence goal</span>
      <div class="metric__value">Candidate landscape</div>
      <span>{week.data.title}</span>
    </article>
    <article class="card metric">
      <span class="muted">Next decision</span>
      <div class="metric__value">{decision.data.id}</div>
      <a href={entryHref("decisions", decision.slug)}>{decision.data.title}</a>
    </article>
  </section>

  <section class="grid grid--cards" style="margin-top: 1rem;">
    <article class="card">
      <h2>Latest verified-ready evidence</h2>
      <Badge label="Preliminary" tone="preliminary" />
      <p>{result.data.observation}</p>
      <p class="muted">{result.data.interpretation}</p>
      <a href={entryHref("results", result.slug)}>Open result page</a>
    </article>
    <article class="card">
      <h2>Current blockers</h2>
      <ul class="list-clean">
        {week.data.blockers.map((blocker) => <li>{blocker}</li>)}
      </ul>
    </article>
    <article class="card">
      <h2>Weekly readiness</h2>
      <ul class="list-clean">
        {week.data.readiness.map((item) => <li>{item}</li>)}
      </ul>
    </article>
  </section>

  <section class="content-panel" style="margin-top: 1rem;">
    <h2>Current evidence snapshot</h2>
    <div class="summary-grid">
      <article class="card metric">
        <span class="muted">Total ClairS-TO calls</span>
        <div class="metric__value">{candidateLandscape.summary.total_calls.toLocaleString()}</div>
      </article>
      <article class="card metric">
        <span class="muted">PASS SNVs retained</span>
        <div class="metric__value">{candidateLandscape.summary.pass_snvs.toLocaleString()}</div>
      </article>
      <article class="card metric">
        <span class="muted">PASS SNV proportion</span>
        <div class="metric__value">{candidateLandscape.summary.pass_snv_fraction_pct}%</div>
      </article>
      <article class="card metric">
        <span class="muted">Median depth / VAF / ALT</span>
        <div class="metric__value">
          {candidateLandscape.summary.median_depth} / {candidateLandscape.summary.median_vaf} / {candidateLandscape.summary.median_alt_support}
        </div>
      </article>
    </div>
  </section>

  <section class="content-panel" style="margin-top: 1rem;">
    <h2>Rolling roadmap</h2>
    <div class="grid grid--cards">
      {researchRoadmap.map((step) => (
        <article class="card">
          <Badge label={step.status} />
          <h3>{step.title}</h3>
          <p>{step.summary}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
