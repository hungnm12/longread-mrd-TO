---
// Why phase and native methylation are candidate evidence axes at all.
//
// The figure answers a mechanistic question — what is physically readable off one long
// molecule, and why the added properties might fail differently from the allele — and it
// stops there. It shows no measurement, no threshold and no method: nothing here asserts
// that either axis works, only why each is worth testing.
//
// The phase column draws the actual argument rather than a label: each read shows the
// alleles it carries at the two flanking heterozygous sites, so "in cis" is visible as the
// ALT travelling with the same neighbouring alleles read after read. Reducing that to an
// "H1/H2" tag would hide the very thing that does the discriminating.
//
// Inline SVG rather than an image so it inherits the page's colour tokens, stays crisp at
// any zoom, and remains searchable and translatable text. On narrow screens the figure
// scrolls inside its own container instead of shrinking its labels into illegibility.
---

<figure class="mechanism">
  <div class="mechanism__scroll">
    <svg
      class="mechanism__svg"
      viewBox="-6 0 992 664"
      role="img"
      aria-labelledby="mechanism-title mechanism-desc"
    >
      <title id="mechanism-title">
        Why phase and native methylation are candidate evidence axes
      </title>
      <desc id="mechanism-desc">
        Panel A shows one long read carrying three properties at once: the allele at a
        candidate site, the alleles at neighbouring heterozygous sites that place the read on
        a haplotype, and native CpG methylation calls. Panel B contrasts tumor-derived reads
        with background reads under three evidence configurations. With the allele alone the
        two are identical. Adding phase shows the candidate ALT carried in cis with the same
        neighbouring alleles, A and T, on every tumor-derived read, whereas background ALT
        observations appear on both the A–T and the G–C haplotype backgrounds. Adding native
        methylation shows two different CpG patterns, a property of the cell of origin rather
        than of the basecall.
      </desc>

      <!-- PANEL A -->
      <text x="0" y="16" class="mech-panel-label">A · One long read carries three properties at once</text>

      <!-- annotation: candidate allele -->
      <text x="500" y="54" class="mech-note" text-anchor="middle">candidate ALT allele</text>
      <line x1="500" y1="62" x2="500" y2="76" class="mech-leader" />

      <!-- annotation: haplotype context -->
      <text x="230" y="38" class="mech-note" text-anchor="middle">
        <tspan x="230">neighbouring heterozygous alleles,</tspan>
        <tspan x="230" dy="16">read in cis with the candidate</tspan>
      </text>
      <line x1="230" y1="62" x2="230" y2="86" class="mech-leader" />
      <line x1="318" y1="62" x2="352" y2="86" class="mech-leader" />
      <line x1="142" y1="62" x2="110" y2="86" class="mech-leader" />

      <!-- the molecule -->
      <rect x="60" y="80" width="860" height="34" rx="17" class="mech-read" />
      <text x="70" y="102" class="mech-read-label">5′</text>
      <text x="898" y="102" class="mech-read-label">3′</text>

      <!-- heterozygous variants on the same fragment, with the allele this read carries -->
      <g>
        <circle cx="110" cy="97" r="9" class="mech-het" />
        <text x="110" y="101" class="mech-allele-text" text-anchor="middle">C</text>
        <circle cx="230" cy="97" r="9" class="mech-het" />
        <text x="230" y="101" class="mech-allele-text" text-anchor="middle">A</text>
        <circle cx="352" cy="97" r="9" class="mech-het" />
        <text x="352" y="101" class="mech-allele-text" text-anchor="middle">A</text>
        <circle cx="700" cy="97" r="9" class="mech-het" />
        <text x="700" y="101" class="mech-allele-text" text-anchor="middle">T</text>
        <circle cx="822" cy="97" r="9" class="mech-het" />
        <text x="822" y="101" class="mech-allele-text" text-anchor="middle">G</text>
      </g>

      <!-- candidate somatic allele -->
      <polygon points="500,81 516,97 500,113 484,97" class="mech-alt" />

      <!-- native methylation calls -->
      <g class="mech-cpg">
        <line x1="100" y1="114" x2="100" y2="136" /><circle cx="100" cy="141" r="6" class="mech-cpg--on" />
        <line x1="160" y1="114" x2="160" y2="136" /><circle cx="160" cy="141" r="6" class="mech-cpg--off" />
        <line x1="220" y1="114" x2="220" y2="136" /><circle cx="220" cy="141" r="6" class="mech-cpg--on" />
        <line x1="280" y1="114" x2="280" y2="136" /><circle cx="280" cy="141" r="6" class="mech-cpg--on" />
        <line x1="340" y1="114" x2="340" y2="136" /><circle cx="340" cy="141" r="6" class="mech-cpg--off" />
        <line x1="400" y1="114" x2="400" y2="136" /><circle cx="400" cy="141" r="6" class="mech-cpg--on" />
        <line x1="460" y1="114" x2="460" y2="136" /><circle cx="460" cy="141" r="6" class="mech-cpg--off" />
        <line x1="520" y1="114" x2="520" y2="136" /><circle cx="520" cy="141" r="6" class="mech-cpg--on" />
        <line x1="580" y1="114" x2="580" y2="136" /><circle cx="580" cy="141" r="6" class="mech-cpg--on" />
        <line x1="640" y1="114" x2="640" y2="136" /><circle cx="640" cy="141" r="6" class="mech-cpg--off" />
        <line x1="700" y1="114" x2="700" y2="136" /><circle cx="700" cy="141" r="6" class="mech-cpg--on" />
        <line x1="760" y1="114" x2="760" y2="136" /><circle cx="760" cy="141" r="6" class="mech-cpg--off" />
        <line x1="820" y1="114" x2="820" y2="136" /><circle cx="820" cy="141" r="6" class="mech-cpg--on" />
        <line x1="880" y1="114" x2="880" y2="136" /><circle cx="880" cy="141" r="6" class="mech-cpg--on" />
      </g>
      <text x="490" y="172" class="mech-note" text-anchor="middle">
        native CpG methylation, called from the same signal — no separate assay
      </text>

      <!-- legend -->
      <g>
        <circle cx="66" cy="196" r="6" class="mech-cpg--on" />
        <text x="80" y="200" class="mech-small">methylated</text>
        <circle cx="186" cy="196" r="6" class="mech-cpg--off" />
        <text x="200" y="200" class="mech-small">unmethylated</text>
        <polygon points="316,190 326,196 316,202 306,196" class="mech-alt" />
        <text x="334" y="200" class="mech-small">candidate ALT</text>
        <circle cx="452" cy="196" r="7" class="mech-het" />
        <text x="452" y="199.5" class="mech-allele-text" text-anchor="middle">A</text>
        <text x="466" y="200" class="mech-small">allele at a heterozygous site</text>
      </g>

      <line x1="0" y1="222" x2="980" y2="222" class="mech-rule" />

      <!-- PANEL B -->
      <text x="0" y="252" class="mech-panel-label">
        B · The added properties fail differently from the allele
      </text>

      <!-- row labels -->
      <text x="0" y="356" class="mech-row-label">tumor-derived</text>
      <text x="0" y="372" class="mech-row-label">reads</text>
      <text x="0" y="480" class="mech-row-label">background reads</text>
      <text x="0" y="496" class="mech-row-sub">(error, germline, artifact)</text>

      <!-- column 1: allele only -->
      <g>
        <rect x="190" y="272" width="240" height="28" rx="14" class="mech-chip mech-chip--muted" />
        <text x="310" y="291" class="mech-chip-text" text-anchor="middle">allele only</text>

        <rect x="190" y="318" width="240" height="88" rx="8" class="mech-cell" />
        <rect x="206" y="331" width="208" height="10" rx="5" class="mech-mini-read" />
        <polygon points="310,327 320,336 310,345 300,336" class="mech-alt" />
        <rect x="206" y="357" width="208" height="10" rx="5" class="mech-mini-read" />
        <polygon points="310,353 320,362 310,371 300,362" class="mech-alt" />
        <rect x="206" y="383" width="208" height="10" rx="5" class="mech-mini-read" />
        <polygon points="310,379 320,388 310,397 300,388" class="mech-alt" />

        <text x="310" y="426" class="mech-equals" text-anchor="middle">identical evidence</text>

        <rect x="190" y="438" width="240" height="88" rx="8" class="mech-cell" />
        <rect x="206" y="451" width="208" height="10" rx="5" class="mech-mini-read" />
        <polygon points="310,447 320,456 310,465 300,456" class="mech-alt" />
        <rect x="206" y="477" width="208" height="10" rx="5" class="mech-mini-read" />
        <polygon points="310,473 320,482 310,491 300,482" class="mech-alt" />
        <rect x="206" y="503" width="208" height="10" rx="5" class="mech-mini-read" />
        <polygon points="310,499 320,508 310,517 300,508" class="mech-alt" />

        <rect x="190" y="556" width="240" height="64" rx="8" class="mech-verdict mech-verdict--bad" />
        <text x="310" y="578" class="mech-verdict-text mech-verdict-text--bad" text-anchor="middle">indistinguishable</text>
        <text x="310" y="594" class="mech-small mech-small--bad" text-anchor="middle">
          <tspan x="310">one ALT read looks the same</tspan>
          <tspan x="310" dy="15">whichever molecule it came from</tspan>
        </text>
      </g>

      <!-- column 2: + phase, drawn as cis linkage with the flanking alleles -->
      <g>
        <rect x="450" y="272" width="240" height="28" rx="14" class="mech-chip" />
        <text x="570" y="291" class="mech-chip-text" text-anchor="middle">+ phase (cis linkage)</text>
        <text x="570" y="311" class="mech-tiny" text-anchor="middle">
          het sites A/G and T/C → haplotypes A–T and G–C
        </text>

        <rect x="450" y="318" width="240" height="88" rx="8" class="mech-cell" />
        <g>
          <rect x="482" y="326" width="176" height="20" rx="10" class="mech-hap mech-hap--one" />
          <rect x="470" y="331" width="204" height="10" rx="5" class="mech-mini-read" />
          <circle cx="500" cy="336" r="9" class="mech-allele mech-allele--one" />
          <text x="500" y="339.5" class="mech-allele-text" text-anchor="middle">A</text>
          <polygon points="572,327 582,336 572,345 562,336" class="mech-alt" />
          <circle cx="644" cy="336" r="9" class="mech-allele mech-allele--one" />
          <text x="644" y="339.5" class="mech-allele-text" text-anchor="middle">T</text>
        </g>
        <g>
          <rect x="482" y="352" width="176" height="20" rx="10" class="mech-hap mech-hap--one" />
          <rect x="470" y="357" width="204" height="10" rx="5" class="mech-mini-read" />
          <circle cx="500" cy="362" r="9" class="mech-allele mech-allele--one" />
          <text x="500" y="365.5" class="mech-allele-text" text-anchor="middle">A</text>
          <polygon points="572,353 582,362 572,371 562,362" class="mech-alt" />
          <circle cx="644" cy="362" r="9" class="mech-allele mech-allele--one" />
          <text x="644" y="365.5" class="mech-allele-text" text-anchor="middle">T</text>
        </g>
        <g>
          <rect x="482" y="378" width="176" height="20" rx="10" class="mech-hap mech-hap--one" />
          <rect x="470" y="383" width="204" height="10" rx="5" class="mech-mini-read" />
          <circle cx="500" cy="388" r="9" class="mech-allele mech-allele--one" />
          <text x="500" y="391.5" class="mech-allele-text" text-anchor="middle">A</text>
          <polygon points="572,379 582,388 572,397 562,388" class="mech-alt" />
          <circle cx="644" cy="388" r="9" class="mech-allele mech-allele--one" />
          <text x="644" y="391.5" class="mech-allele-text" text-anchor="middle">T</text>
        </g>

        <text x="570" y="426" class="mech-small" text-anchor="middle">always A–T vs both backgrounds</text>

        <rect x="450" y="438" width="240" height="88" rx="8" class="mech-cell" />
        <g>
          <rect x="482" y="446" width="176" height="20" rx="10" class="mech-hap mech-hap--one" />
          <rect x="470" y="451" width="204" height="10" rx="5" class="mech-mini-read" />
          <circle cx="500" cy="456" r="9" class="mech-allele mech-allele--one" />
          <text x="500" y="459.5" class="mech-allele-text" text-anchor="middle">A</text>
          <polygon points="572,447 582,456 572,465 562,456" class="mech-alt" />
          <circle cx="644" cy="456" r="9" class="mech-allele mech-allele--one" />
          <text x="644" y="459.5" class="mech-allele-text" text-anchor="middle">T</text>
        </g>
        <g>
          <rect x="482" y="472" width="176" height="20" rx="10" class="mech-hap mech-hap--two" />
          <rect x="470" y="477" width="204" height="10" rx="5" class="mech-mini-read" />
          <circle cx="500" cy="482" r="9" class="mech-allele mech-allele--two" />
          <text x="500" y="485.5" class="mech-allele-text" text-anchor="middle">G</text>
          <polygon points="572,473 582,482 572,491 562,482" class="mech-alt" />
          <circle cx="644" cy="482" r="9" class="mech-allele mech-allele--two" />
          <text x="644" y="485.5" class="mech-allele-text" text-anchor="middle">C</text>
        </g>
        <g>
          <rect x="482" y="498" width="176" height="20" rx="10" class="mech-hap mech-hap--two" />
          <rect x="470" y="503" width="204" height="10" rx="5" class="mech-mini-read" />
          <circle cx="500" cy="508" r="9" class="mech-allele mech-allele--two" />
          <text x="500" y="511.5" class="mech-allele-text" text-anchor="middle">G</text>
          <polygon points="572,499 582,508 572,517 562,508" class="mech-alt" />
          <circle cx="644" cy="508" r="9" class="mech-allele mech-allele--two" />
          <text x="644" y="511.5" class="mech-allele-text" text-anchor="middle">C</text>
        </g>

        <rect x="450" y="556" width="240" height="64" rx="8" class="mech-verdict" />
        <text x="570" y="578" class="mech-verdict-text" text-anchor="middle">a second constraint</text>
        <text x="570" y="594" class="mech-small mech-small--accent" text-anchor="middle">
          <tspan x="570">a true variant stays in cis;</tspan>
          <tspan x="570" dy="15">an error does not have to</tspan>
        </text>
      </g>

      <!-- column 3: + native methylation -->
      <g>
        <rect x="710" y="272" width="240" height="28" rx="14" class="mech-chip" />
        <text x="830" y="291" class="mech-chip-text" text-anchor="middle">+ native methylation</text>

        <rect x="710" y="318" width="240" height="88" rx="8" class="mech-cell" />
        <g class="mech-cpg mech-cpg--mini">
          <rect x="726" y="331" width="208" height="10" rx="5" class="mech-mini-read" />
          <circle cx="746" cy="336" r="5" class="mech-cpg--on" />
          <circle cx="782" cy="336" r="5" class="mech-cpg--on" />
          <circle cx="818" cy="336" r="5" class="mech-cpg--off" />
          <circle cx="854" cy="336" r="5" class="mech-cpg--on" />
          <circle cx="890" cy="336" r="5" class="mech-cpg--on" />
          <circle cx="918" cy="336" r="5" class="mech-cpg--on" />

          <rect x="726" y="357" width="208" height="10" rx="5" class="mech-mini-read" />
          <circle cx="746" cy="362" r="5" class="mech-cpg--on" />
          <circle cx="782" cy="362" r="5" class="mech-cpg--off" />
          <circle cx="818" cy="362" r="5" class="mech-cpg--on" />
          <circle cx="854" cy="362" r="5" class="mech-cpg--on" />
          <circle cx="890" cy="362" r="5" class="mech-cpg--on" />
          <circle cx="918" cy="362" r="5" class="mech-cpg--on" />

          <rect x="726" y="383" width="208" height="10" rx="5" class="mech-mini-read" />
          <circle cx="746" cy="388" r="5" class="mech-cpg--on" />
          <circle cx="782" cy="388" r="5" class="mech-cpg--on" />
          <circle cx="818" cy="388" r="5" class="mech-cpg--on" />
          <circle cx="854" cy="388" r="5" class="mech-cpg--off" />
          <circle cx="890" cy="388" r="5" class="mech-cpg--on" />
          <circle cx="918" cy="388" r="5" class="mech-cpg--on" />
        </g>

        <text x="830" y="426" class="mech-small" text-anchor="middle">different cell of origin, different pattern</text>

        <rect x="710" y="438" width="240" height="88" rx="8" class="mech-cell" />
        <g class="mech-cpg mech-cpg--mini">
          <rect x="726" y="451" width="208" height="10" rx="5" class="mech-mini-read" />
          <circle cx="746" cy="456" r="5" class="mech-cpg--off" />
          <circle cx="782" cy="456" r="5" class="mech-cpg--off" />
          <circle cx="818" cy="456" r="5" class="mech-cpg--on" />
          <circle cx="854" cy="456" r="5" class="mech-cpg--off" />
          <circle cx="890" cy="456" r="5" class="mech-cpg--off" />
          <circle cx="918" cy="456" r="5" class="mech-cpg--off" />

          <rect x="726" y="477" width="208" height="10" rx="5" class="mech-mini-read" />
          <circle cx="746" cy="482" r="5" class="mech-cpg--off" />
          <circle cx="782" cy="482" r="5" class="mech-cpg--on" />
          <circle cx="818" cy="482" r="5" class="mech-cpg--off" />
          <circle cx="854" cy="482" r="5" class="mech-cpg--off" />
          <circle cx="890" cy="482" r="5" class="mech-cpg--off" />
          <circle cx="918" cy="482" r="5" class="mech-cpg--off" />

          <rect x="726" y="503" width="208" height="10" rx="5" class="mech-mini-read" />
          <circle cx="746" cy="508" r="5" class="mech-cpg--off" />
          <circle cx="782" cy="508" r="5" class="mech-cpg--off" />
          <circle cx="818" cy="508" r="5" class="mech-cpg--off" />
          <circle cx="854" cy="508" r="5" class="mech-cpg--on" />
          <circle cx="890" cy="508" r="5" class="mech-cpg--off" />
          <circle cx="918" cy="508" r="5" class="mech-cpg--off" />
        </g>

        <rect x="710" y="556" width="240" height="64" rx="8" class="mech-verdict" />
        <text x="830" y="578" class="mech-verdict-text" text-anchor="middle">an independent axis</text>
        <text x="830" y="594" class="mech-small mech-small--accent" text-anchor="middle">
          <tspan x="830">a basecalling error does not</tspan>
          <tspan x="830" dy="15">repaint a molecule&#39;s methylation</tspan>
        </text>
      </g>

      <!-- haplotype key for the phase column -->
      <g>
        <rect x="450" y="634" width="26" height="12" rx="6" class="mech-hap mech-hap--one" />
        <text x="484" y="644" class="mech-small">A–T haplotype</text>
        <rect x="586" y="634" width="26" height="12" rx="6" class="mech-hap mech-hap--two" />
        <text x="620" y="644" class="mech-small">G–C haplotype</text>
      </g>
    </svg>
  </div>

  <figcaption class="mechanism__caption">
    <slot />
  </figcaption>
</figure>
