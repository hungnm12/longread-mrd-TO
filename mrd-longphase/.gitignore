*.cram
*.crai
*.fasta
*.fa
*.fasta.fai
*.fa.fai
*.fastq
*.fastq.gz
*.fq.gz
# VCFs / indexes (keep small curated ones with `git add -f` if needed)
*.vcf
*.vcf.gz
*.vcf.gz.tbi
*.bcf
*.bed.gz
*.bed.gz.tbi

